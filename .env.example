# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE WEB CONFIG (Opcional si ya usas firebase-applet-config.json)
# Completa estas variables en .env para conectar con tu propio proyecto Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# FIREBASE CLOUD MESSAGING WEB PUSH (VAPID Public Key para notificaciones con PWA cerrada)
VITE_FIREBASE_VAPID_KEY=

