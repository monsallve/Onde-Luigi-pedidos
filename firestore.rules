rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAuthenticatedEmailUser() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email.size() > 0;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'perrodog1515@gmail.com';
    }

    function workspacePath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId);
    }

    function workspaceExists(workspaceId) {
      return exists(workspacePath(workspaceId));
    }

    function memberPath(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }

    function staffPath(workspaceId, staffId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/staff/$(staffId);
    }

    function directoryPath(workspaceId) {
      return /databases/$(database)/documents/workspaceDirectory/$(workspaceId);
    }

    function isActiveWorkspaceMember(workspaceId) {
      return isAuthenticatedEmailUser() &&
        exists(memberPath(workspaceId, request.auth.uid)) &&
        get(memberPath(workspaceId, request.auth.uid)).data.active == true;
    }

    function isActiveWorkspaceMemberAfter(workspaceId) {
      return isAuthenticatedEmailUser() &&
        existsAfter(memberPath(workspaceId, request.auth.uid)) &&
        getAfter(memberPath(workspaceId, request.auth.uid)).data.active == true;
    }

    function isPrimaryAdmin(workspaceId) {
      return isAuthenticatedEmailUser() && (
        isBootstrappedAdmin() ||
        (workspaceExists(workspaceId) && get(workspacePath(workspaceId)).data.ownerUid == request.auth.uid)
      );
    }

    function isWorkspaceAdmin(workspaceId) {
      return isAuthenticatedEmailUser() && (
        isPrimaryAdmin(workspaceId) ||
        (isActiveWorkspaceMember(workspaceId) && get(memberPath(workspaceId, request.auth.uid)).data.role == 'admin') ||
        (
          (!exists(memberPath(workspaceId, request.auth.uid)) || get(memberPath(workspaceId, request.auth.uid)).data.active == true) &&
          exists(staffPath(workspaceId, 'staff_' + request.auth.uid)) &&
          get(staffPath(workspaceId, 'staff_' + request.auth.uid)).data.active == true &&
          get(staffPath(workspaceId, 'staff_' + request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isAuthorizedWorkspaceUser(workspaceId) {
      return isAuthenticatedEmailUser() && (
        isPrimaryAdmin(workspaceId) ||
        isActiveWorkspaceMember(workspaceId)
      );
    }

    function canListWorkspaceSubcollection(workspaceId) {
      return isAuthenticatedEmailUser() && (
        isBootstrappedAdmin() ||
        (
          isActiveWorkspaceMember(workspaceId) &&
          workspaceExists(workspaceId) &&
          resource.data.ownerUid == get(workspacePath(workspaceId)).data.ownerUid
        ) ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.createdByUid == request.auth.uid
      );
    }

    function isStringBounded(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function hasNoCodeInjection(val) {
      return val is string &&
        !val.matches('.*(<|>|\\$\\{|\\{\\{|<%|<\\?).*') &&
        !val.matches('(?i).*(javascript:|vbscript:|data:text/html|data:application/x-javascript|image/svg\\+xml).*') &&
        !val.matches('(?i).*(\\bon(error|load|click|mouseover|focus|submit|input|change)\\s*=|\\beval\\s*\\(|\\bnew\\s+Function\\s*\\(|document\\.cookie|window\\.location).*');
    }

    function isSafeTextBounded(val, minLen, maxLen) {
      return isStringBounded(val, minLen, maxLen) && hasNoCodeInjection(val);
    }

    function isSafeUrlBounded(val, minLen, maxLen) {
      return isStringBounded(val, minLen, maxLen) &&
        !val.matches('.*(<|>|\\$\\{|\\{\\{|<%|<\\?).*') &&
        !val.matches('(?i).*(javascript:|vbscript:|data:text/html|data:application/x-javascript|image/svg\\+xml).*') &&
        (
          val.size() == 0 ||
          val.matches('^(https?://|\\./|/|data:image/(png|jpeg|jpg|webp|gif);base64,).*')
        );
    }

    function isStringListBounded(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && hasNoCodeInjection(arr[0])));
    }

    // 3. Entity Validation Blueprints
    function isValidBillingConfig(cfg) {
      return cfg is map &&
        cfg.keys().hasAll([
          'businessName', 'legalName', 'nit', 'regime', 'address',
          'city', 'phone', 'email', 'receiptPrefix', 'footerNote'
        ]) &&
        cfg.keys().hasOnly([
          'businessName', 'legalName', 'nit', 'regime', 'address',
          'city', 'phone', 'email', 'receiptPrefix', 'footerNote'
        ]) &&
        isSafeTextBounded(cfg.businessName, 1, 120) &&
        isSafeTextBounded(cfg.legalName, 0, 120) &&
        isSafeTextBounded(cfg.nit, 0, 40) &&
        isSafeTextBounded(cfg.regime, 0, 80) &&
        isSafeTextBounded(cfg.address, 0, 160) &&
        isSafeTextBounded(cfg.city, 0, 80) &&
        isSafeTextBounded(cfg.phone, 0, 40) &&
        isSafeTextBounded(cfg.email, 0, 160) &&
        isSafeTextBounded(cfg.receiptPrefix, 1, 12) &&
        isSafeTextBounded(cfg.footerNote, 0, 280);
    }

    function isValidSelfServiceConfig(cfg) {
      return cfg is map &&
        cfg.keys().hasAll([
          'enabled', 'qrImageUrl', 'brebKey', 'accountHolder',
          'bankName', 'paymentInstructions', 'deliveryInstructions'
        ]) &&
        cfg.keys().hasOnly([
          'enabled', 'qrImageUrl', 'brebKey', 'accountHolder',
          'bankName', 'paymentInstructions', 'deliveryInstructions'
        ]) &&
        cfg.enabled is bool &&
        isSafeUrlBounded(cfg.qrImageUrl, 0, 250000) &&
        isSafeTextBounded(cfg.brebKey, 0, 100) &&
        isSafeTextBounded(cfg.accountHolder, 0, 120) &&
        isSafeTextBounded(cfg.bankName, 0, 120) &&
        isSafeTextBounded(cfg.paymentInstructions, 0, 400) &&
        isSafeTextBounded(cfg.deliveryInstructions, 0, 400);
    }

    function isValidWorkspace(data, workspaceId) {
      return data.keys().hasAll(['id', 'name', 'ownerUid', 'ownerEmail', 'authorizedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'ownerUid', 'ownerEmail', 'authorizedEmails', 'billingConfig', 'selfServiceConfig', 'createdAt', 'updatedAt']) &&
        data.id == workspaceId &&
        isSafeTextBounded(data.name, 1, 120) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isSafeTextBounded(data.ownerEmail, 3, 160) &&
        isStringListBounded(data.authorizedEmails, 25) &&
        (!('billingConfig' in data) || isValidBillingConfig(data.billingConfig)) &&
        (!('selfServiceConfig' in data) || isValidSelfServiceConfig(data.selfServiceConfig)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkspaceDirectory(data, workspaceId) {
      return data.keys().hasAll(['id', 'name', 'ownerUid', 'allowSelfRegistration', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'ownerUid', 'allowSelfRegistration', 'updatedAt']) &&
        data.id == workspaceId &&
        isSafeTextBounded(data.name, 1, 120) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        data.allowSelfRegistration is bool &&
        data.updatedAt is timestamp;
    }

    function isValidWorkspaceMember(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'active', 'ownerUid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'active', 'ownerUid', 'createdAt']) &&
        data.uid == uid &&
        isSafeTextBounded(data.displayName, 1, 100) &&
        data.role in ['admin', 'mesero'] &&
        data.active is bool &&
        isStringBounded(data.ownerUid, 1, 128) &&
        data.createdAt is timestamp;
    }

    function isValidStaffMember(data, staffId) {
      return data.keys().hasAll(['id', 'name', 'role', 'active', 'linkedUid', 'linkedEmail', 'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'role', 'active', 'linkedUid', 'linkedEmail', 'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.id == staffId &&
        isSafeTextBounded(data.name, 1, 80) &&
        data.role in ['admin', 'mesero', 'cajero', 'cocina'] &&
        data.active is bool &&
        isStringBounded(data.linkedUid, 0, 128) &&
        isSafeTextBounded(data.linkedEmail, 0, 160) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSauce(data, sauceId) {
      return data.keys().hasAll(['id', 'name', 'active', 'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'active', 'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.id == sauceId &&
        isSafeTextBounded(data.name, 1, 60) &&
        data.active is bool &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data, productId) {
      return data.keys().hasAll(['id', 'name', 'category', 'basePrice', 'imageUrl', 'baseRecipe', 'removableOptions', 'addonOptions', 'allowSauces', 'minSauces', 'maxSauces', 'active', 'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'category', 'basePrice', 'imageUrl', 'baseRecipe', 'removableOptions', 'recipeIngredients', 'addonOptions', 'allowSauces', 'minSauces', 'maxSauces', 'active', 'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.id == productId &&
        isSafeTextBounded(data.name, 1, 100) &&
        isSafeTextBounded(data.category, 1, 60) &&
        data.basePrice is number && data.basePrice >= 0 && data.basePrice <= 100000000 &&
        isSafeUrlBounded(data.imageUrl, 0, 250000) &&
        isStringListBounded(data.baseRecipe, 30) &&
        isStringListBounded(data.removableOptions, 30) &&
        (!('recipeIngredients' in data) || (
          data.recipeIngredients is list &&
          data.recipeIngredients.size() <= 30 &&
          (data.recipeIngredients.size() == 0 || (
            data.recipeIngredients[0] is map &&
            data.recipeIngredients[0].keys().hasAll(['inventoryItemId', 'name', 'quantity', 'unit', 'removable'])
          ))
        )) &&
        data.addonOptions is list && data.addonOptions.size() <= 30 &&
        (data.addonOptions.size() == 0 || (data.addonOptions[0] is map && data.addonOptions[0].keys().hasAll(['id', 'name', 'price']))) &&
        data.allowSauces is bool &&
        data.minSauces is number && data.minSauces >= 0 && data.minSauces <= 4 &&
        data.maxSauces is number && data.maxSauces >= 0 && data.maxSauces <= 4 &&
        data.active is bool &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasAll(['id', 'orderNumber', 'reference', 'waiterId', 'waiterName', 'status', 'paymentStatus', 'paymentMethod', 'items', 'subtotal', 'total', 'notes', 'receiptCount', 'latestReceiptUrl', 'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'orderNumber', 'reference', 'waiterId', 'waiterName', 'status', 'paymentStatus', 'paymentMethod', 'items', 'subtotal', 'total', 'notes', 'receiptCount', 'latestReceiptUrl', 'receiptStoragePath', 'source', 'deliveryType', 'deliveryAddress', 'deliveryNeighborhood', 'deliveryPhone', 'deliveryNotes', 'customerId', 'customerDocument', 'customerName', 'customerPhone', 'customerEmail', 'inventoryDeducted', 'voidReason', 'voidedByName', 'voidedAtMs', 'refundMethod', 'refundAmount', 'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.id == orderId &&
        data.orderNumber is number && data.orderNumber >= 1 && data.orderNumber <= 10000000 &&
        isSafeTextBounded(data.reference, 1, 100) &&
        isStringBounded(data.waiterId, 1, 128) &&
        isSafeTextBounded(data.waiterName, 1, 80) &&
        data.status in ['pendiente_validacion', 'tomado', 'preparacion', 'listo', 'entregado', 'cancelado'] &&
        data.paymentStatus in ['pendiente', 'pagado'] &&
        data.paymentMethod in ['', 'efectivo', 'transferencia', 'tarjeta', 'otro'] &&
        data.items is list && data.items.size() <= 50 &&
        (data.items.size() == 0 || (data.items[0] is map && data.items[0].keys().hasAll(['lineId', 'productId', 'productName', 'quantity', 'unitPrice', 'lineTotal']) && isSafeTextBounded(data.items[0].productName, 1, 100))) &&
        data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 100000000 &&
        data.total is number && data.total >= 0 && data.total <= 100000000 &&
        isSafeTextBounded(data.notes, 0, 400) &&
        data.receiptCount is number && data.receiptCount >= 0 && data.receiptCount <= 100 &&
        isSafeUrlBounded(data.latestReceiptUrl, 0, 250000) &&
        (!('receiptStoragePath' in data) || isSafeTextBounded(data.receiptStoragePath, 0, 500)) &&
        (!('source' in data) || data.source in ['pos', 'autoservicio']) &&
        (!('deliveryType' in data) || data.deliveryType in ['local', 'domicilio']) &&
        (!('deliveryAddress' in data) || isSafeTextBounded(data.deliveryAddress, 0, 220)) &&
        (!('deliveryNeighborhood' in data) || isSafeTextBounded(data.deliveryNeighborhood, 0, 100)) &&
        (!('deliveryPhone' in data) || isSafeTextBounded(data.deliveryPhone, 0, 40)) &&
        (!('deliveryNotes' in data) || isSafeTextBounded(data.deliveryNotes, 0, 240)) &&
        (!('customerId' in data) || isStringBounded(data.customerId, 0, 128)) &&
        (!('customerDocument' in data) || isSafeTextBounded(data.customerDocument, 0, 40)) &&
        (!('customerName' in data) || isSafeTextBounded(data.customerName, 0, 120)) &&
        (!('customerPhone' in data) || isSafeTextBounded(data.customerPhone, 0, 40)) &&
        (!('customerEmail' in data) || isSafeTextBounded(data.customerEmail, 0, 160)) &&
        (!('inventoryDeducted' in data) || data.inventoryDeducted is map) &&
        (!('voidReason' in data) || isSafeTextBounded(data.voidReason, 0, 240)) &&
        (!('voidedByName' in data) || isSafeTextBounded(data.voidedByName, 0, 80)) &&
        (!('voidedAtMs' in data) || data.voidedAtMs is number) &&
        (!('refundMethod' in data) || data.refundMethod in ['', 'efectivo', 'transferencia', 'tarjeta', 'otro']) &&
        (!('refundAmount' in data) || (data.refundAmount is number && data.refundAmount >= 0 && data.refundAmount <= 100000000)) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMovement(data, movementId) {
      return data.keys().hasAll(['id', 'orderId', 'orderNumber', 'orderReference', 'type', 'description', 'waiterId', 'waiterName', 'actorUid', 'details', 'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt']) &&
        data.keys().hasOnly(['id', 'orderId', 'orderNumber', 'orderReference', 'type', 'description', 'waiterId', 'waiterName', 'actorUid', 'details', 'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt']) &&
        data.id == movementId &&
        isStringBounded(data.orderId, 1, 128) &&
        data.orderNumber is number && data.orderNumber >= 1 &&
        isSafeTextBounded(data.orderReference, 1, 100) &&
        data.type in ['creacion', 'edicion_items', 'estado_pedido', 'estado_pago', 'comprobante'] &&
        isSafeTextBounded(data.description, 1, 500) &&
        isStringBounded(data.waiterId, 1, 128) &&
        isSafeTextBounded(data.waiterName, 1, 80) &&
        isStringBounded(data.actorUid, 1, 128) &&
        data.details is map &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp;
    }

    function isValidTransfer(data, transferId) {
      return data.keys().hasAll(['id', 'orderId', 'orderNumber', 'orderReference', 'amount', 'imageUrl', 'storagePath', 'waiterId', 'waiterName', 'paymentStatus', 'notes', 'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt']) &&
        data.keys().hasOnly(['id', 'orderId', 'orderNumber', 'orderReference', 'amount', 'imageUrl', 'storagePath', 'waiterId', 'waiterName', 'paymentStatus', 'notes', 'annulled', 'annulledByName', 'annulledReason', 'annulledAtMs', 'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt']) &&
        data.id == transferId &&
        isStringBounded(data.orderId, 1, 128) &&
        data.orderNumber is number && data.orderNumber >= 1 &&
        isSafeTextBounded(data.orderReference, 1, 100) &&
        data.amount is number && data.amount >= 0 && data.amount <= 100000000 &&
        isSafeUrlBounded(data.imageUrl, 1, 250000) &&
        isSafeTextBounded(data.storagePath, 0, 500) &&
        isStringBounded(data.waiterId, 1, 128) &&
        isSafeTextBounded(data.waiterName, 1, 80) &&
        data.paymentStatus in ['pagado', 'pendiente'] &&
        isSafeTextBounded(data.notes, 0, 300) &&
        (!('annulled' in data) || data.annulled is bool) &&
        (!('annulledByName' in data) || isSafeTextBounded(data.annulledByName, 0, 80)) &&
        (!('annulledReason' in data) || isSafeTextBounded(data.annulledReason, 0, 240)) &&
        (!('annulledAtMs' in data) || data.annulledAtMs is number) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp;
    }

    function isValidShift(data, shiftId) {
      return data.keys().hasAll([
          'id', 'status', 'openingBaseAmount', 'openingNote',
          'openedByStaffId', 'openedByName', 'openedByUid',
          'closedByStaffId', 'closedByName', 'closedByUid', 'closingNote',
          'usedPaymentMethods', 'declaredClosingBase', 'declaredByMethod',
          'expectedBaseAmount', 'expectedByMethod', 'expectedTotal',
          'declaredTotal', 'differenceTotal', 'paidOrdersCount', 'pendingOrdersCount',
          'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'status', 'openingBaseAmount', 'openingNote',
          'openedByStaffId', 'openedByName', 'openedByUid',
          'closedByStaffId', 'closedByName', 'closedByUid', 'closingNote',
          'usedPaymentMethods', 'declaredClosingBase', 'declaredByMethod',
          'expectedBaseAmount', 'expectedByMethod', 'expectedTotal',
          'declaredTotal', 'differenceTotal', 'paidOrdersCount', 'pendingOrdersCount',
          'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.id == shiftId &&
        data.status in ['abierto', 'cerrado'] &&
        data.openingBaseAmount is number && data.openingBaseAmount >= 0 && data.openingBaseAmount <= 100000000 &&
        isSafeTextBounded(data.openingNote, 0, 300) &&
        isStringBounded(data.openedByStaffId, 1, 128) &&
        isSafeTextBounded(data.openedByName, 1, 80) &&
        isStringBounded(data.openedByUid, 1, 128) &&
        isStringBounded(data.closedByStaffId, 0, 128) &&
        isSafeTextBounded(data.closedByName, 0, 80) &&
        isStringBounded(data.closedByUid, 0, 128) &&
        isSafeTextBounded(data.closingNote, 0, 300) &&
        isStringListBounded(data.usedPaymentMethods, 6) &&
        data.declaredClosingBase is number && data.declaredClosingBase >= 0 && data.declaredClosingBase <= 100000000 &&
        data.declaredByMethod is map &&
        data.expectedBaseAmount is number && data.expectedBaseAmount >= 0 && data.expectedBaseAmount <= 100000000 &&
        data.expectedByMethod is map &&
        data.expectedTotal is number && data.expectedTotal >= 0 && data.expectedTotal <= 100000000 &&
        data.declaredTotal is number && data.declaredTotal >= 0 && data.declaredTotal <= 100000000 &&
        data.differenceTotal is number && data.differenceTotal >= -100000000 && data.differenceTotal <= 100000000 &&
        data.paidOrdersCount is number && data.paidOrdersCount >= 0 && data.paidOrdersCount <= 100000 &&
        data.pendingOrdersCount is number && data.pendingOrdersCount >= 0 && data.pendingOrdersCount <= 100000 &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomer(data, customerId) {
      return data.keys().hasAll([
          'id', 'documentNumber', 'name', 'phone', 'email', 'notes',
          'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'documentNumber', 'name', 'phone', 'email', 'notes',
          'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.id == customerId &&
        isSafeTextBounded(data.documentNumber, 1, 40) &&
        isSafeTextBounded(data.name, 1, 120) &&
        isSafeTextBounded(data.phone, 0, 40) &&
        isSafeTextBounded(data.email, 0, 160) &&
        isSafeTextBounded(data.notes, 0, 300) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInventoryItem(data, itemId) {
      return data.keys().hasAll([
          'id', 'name', 'nameKey', 'unit', 'currentStock', 'minStock',
          'unitCost', 'lastPurchaseQuantity', 'lastPurchaseTotalCost', 'active',
          'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'nameKey', 'unit', 'currentStock', 'minStock',
          'unitCost', 'lastPurchaseQuantity', 'lastPurchaseTotalCost', 'active',
          'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.id == itemId &&
        isSafeTextBounded(data.name, 1, 80) &&
        isSafeTextBounded(data.nameKey, 1, 80) &&
        data.unit in ['g', 'ud'] &&
        data.currentStock is number && data.currentStock >= -100000000 && data.currentStock <= 100000000 &&
        data.minStock is number && data.minStock >= 0 && data.minStock <= 100000000 &&
        data.unitCost is number && data.unitCost >= 0 && data.unitCost <= 100000000 &&
        data.lastPurchaseQuantity is number && data.lastPurchaseQuantity >= 0 && data.lastPurchaseQuantity <= 100000000 &&
        data.lastPurchaseTotalCost is number && data.lastPurchaseTotalCost >= 0 && data.lastPurchaseTotalCost <= 100000000 &&
        data.active is bool &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInventoryMovement(data, movId) {
      return data.keys().hasAll([
          'id', 'inventoryItemId', 'ingredientName', 'unit', 'type',
          'quantityDelta', 'purchaseTotalCost', 'calculatedUnitCost',
          'orderId', 'orderNumber', 'notes', 'actorName', 'actorUid',
          'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'inventoryItemId', 'ingredientName', 'unit', 'type',
          'quantityDelta', 'purchaseTotalCost', 'calculatedUnitCost',
          'orderId', 'orderNumber', 'notes', 'actorName', 'actorUid',
          'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt'
        ]) &&
        data.id == movId &&
        isStringBounded(data.inventoryItemId, 1, 128) &&
        isSafeTextBounded(data.ingredientName, 1, 80) &&
        data.unit in ['g', 'ud'] &&
        data.type in ['compra', 'consumo_pedido', 'edicion_pedido', 'anulacion_pedido', 'ajuste_manual', 'fusion'] &&
        data.quantityDelta is number && data.quantityDelta >= -100000000 && data.quantityDelta <= 100000000 &&
        data.purchaseTotalCost is number && data.purchaseTotalCost >= 0 && data.purchaseTotalCost <= 100000000 &&
        data.calculatedUnitCost is number && data.calculatedUnitCost >= 0 && data.calculatedUnitCost <= 100000000 &&
        isStringBounded(data.orderId, 0, 128) &&
        data.orderNumber is number && data.orderNumber >= 0 && data.orderNumber <= 10000000 &&
        isSafeTextBounded(data.notes, 0, 300) &&
        isSafeTextBounded(data.actorName, 1, 80) &&
        isStringBounded(data.actorUid, 1, 128) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp;
    }

    function isValidNotification(data, notifId) {
      return data.keys().hasAll([
          'id', 'type', 'title', 'message', 'orderId', 'orderNumber',
          'shiftId', 'actorName', 'actorUid', 'ownerUid', 'createdByUid',
          'allowedEmails', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'type', 'title', 'message', 'orderId', 'orderNumber',
          'shiftId', 'actorName', 'actorUid', 'ownerUid', 'createdByUid',
          'allowedEmails', 'createdAt'
        ]) &&
        data.id == notifId &&
        data.type in ['nueva_comanda', 'turno_abierto', 'turno_cerrado', 'venta_anulada', 'solicitud_acceso'] &&
        isSafeTextBounded(data.title, 1, 140) &&
        isSafeTextBounded(data.message, 1, 360) &&
        isStringBounded(data.orderId, 0, 128) &&
        data.orderNumber is number && data.orderNumber >= 0 && data.orderNumber <= 10000000 &&
        isStringBounded(data.shiftId, 0, 128) &&
        isSafeTextBounded(data.actorName, 1, 80) &&
        isStringBounded(data.actorUid, 1, 128) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp;
    }

    function isValidAccessRequest(data, reqId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'requestedName', 'status',
          'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'displayName', 'requestedName', 'status',
          'assignedRole', 'reviewedByName', 'reviewedByUid', 'rejectionReason',
          'ownerUid', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == reqId &&
        isSafeTextBounded(data.email, 3, 160) &&
        isSafeTextBounded(data.displayName, 1, 100) &&
        isSafeTextBounded(data.requestedName, 1, 80) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (!('assignedRole' in data) || data.assignedRole in ['admin', 'mesero', 'cajero', 'cocina']) &&
        (!('reviewedByName' in data) || isSafeTextBounded(data.reviewedByName, 0, 80)) &&
        (!('reviewedByUid' in data) || isStringBounded(data.reviewedByUid, 0, 128)) &&
        (!('rejectionReason' in data) || isSafeTextBounded(data.rejectionReason, 0, 240)) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPushSubscription(data, subId) {
      return data.keys().hasAll([
          'id', 'uid', 'staffId', 'staffName', 'email', 'role',
          'active', 'token', 'platform', 'deviceLabel',
          'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'uid', 'staffId', 'staffName', 'email', 'role',
          'active', 'token', 'platform', 'deviceLabel',
          'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.id == subId &&
        isStringBounded(data.uid, 1, 128) &&
        isStringBounded(data.staffId, 1, 128) &&
        isSafeTextBounded(data.staffName, 1, 80) &&
        isSafeTextBounded(data.email, 3, 160) &&
        data.role in ['admin', 'mesero', 'cajero', 'cocina'] &&
        data.active is bool &&
        isSafeTextBounded(data.token, 1, 500) &&
        data.platform in ['android', 'ios', 'desktop', 'unknown'] &&
        isSafeTextBounded(data.deviceLabel, 1, 120) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPurchaseInvoice(data, invoiceId) {
      return data.keys().hasAll([
          'id', 'receiptCode', 'supplierId', 'supplierDocument', 'supplierName',
          'supplierPhone', 'supplierEmail', 'paymentMethod', 'notes', 'lines',
          'inventoriableTotal', 'expensesTotal', 'grandTotal', 'actorName', 'actorUid',
          'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'receiptCode', 'supplierId', 'supplierDocument', 'supplierName',
          'supplierPhone', 'supplierEmail', 'paymentMethod', 'notes', 'lines',
          'inventoriableTotal', 'expensesTotal', 'grandTotal', 'actorName', 'actorUid',
          'ownerUid', 'createdByUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.id == invoiceId &&
        isSafeTextBounded(data.receiptCode, 1, 60) &&
        isStringBounded(data.supplierId, 1, 128) &&
        isSafeTextBounded(data.supplierDocument, 1, 40) &&
        isSafeTextBounded(data.supplierName, 1, 120) &&
        isSafeTextBounded(data.supplierPhone, 0, 40) &&
        isSafeTextBounded(data.supplierEmail, 0, 160) &&
        isSafeTextBounded(data.paymentMethod, 0, 40) &&
        isSafeTextBounded(data.notes, 0, 300) &&
        data.lines is list && data.lines.size() >= 1 && data.lines.size() <= 80 &&
        data.lines[0] is map &&
        data.lines[0].keys().hasAll(['id', 'kind', 'description', 'quantity', 'totalCost', 'calculatedUnitCost']) &&
        isSafeTextBounded(data.lines[0].description, 1, 160) &&
        data.inventoriableTotal is number && data.inventoriableTotal >= 0 && data.inventoriableTotal <= 1000000000 &&
        data.expensesTotal is number && data.expensesTotal >= 0 && data.expensesTotal <= 1000000000 &&
        data.grandTotal is number && data.grandTotal >= 0 && data.grandTotal <= 1000000000 &&
        isSafeTextBounded(data.actorName, 1, 80) &&
        isStringBounded(data.actorUid, 1, 128) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPayrollCompany(data, companyId) {
      return data.keys().hasAll([
          'id', 'name', 'nit', 'address', 'phone', 'email', 'rep', 'legal',
          'logo', 'employees', 'stubs', 'ownerUid', 'createdByUid', 'allowedEmails',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'nit', 'address', 'phone', 'email', 'rep', 'legal',
          'logo', 'employees', 'stubs', 'ownerUid', 'createdByUid', 'allowedEmails',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == companyId &&
        isSafeTextBounded(data.name, 1, 140) &&
        isSafeTextBounded(data.nit, 1, 40) &&
        isSafeTextBounded(data.address, 0, 160) &&
        isSafeTextBounded(data.phone, 0, 40) &&
        isSafeTextBounded(data.email, 0, 160) &&
        isSafeTextBounded(data.rep, 0, 120) &&
        isSafeTextBounded(data.legal, 0, 400) &&
        isSafeUrlBounded(data.logo, 0, 250000) &&
        data.employees is list && data.employees.size() <= 120 &&
        (data.employees.size() == 0 || (
          data.employees[0] is map &&
          data.employees[0].keys().hasAll(['id', 'name', 'document', 'hourlyRate']) &&
          isSafeTextBounded(data.employees[0].name, 1, 120)
        )) &&
        data.stubs is list && data.stubs.size() <= 300 &&
        (data.stubs.size() == 0 || (
          data.stubs[0] is map &&
          data.stubs[0].keys().hasAll(['id', 'employeeId', 'periodKey', 'total'])
        )) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        isStringListBounded(data.allowedEmails, 25) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPublicStorefront(data, workspaceId) {
      return data.keys().hasAll([
          'id', 'businessName', 'enabled', 'qrImageUrl', 'brebKey',
          'accountHolder', 'bankName', 'paymentInstructions', 'deliveryInstructions',
          'ownerUid', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'businessName', 'enabled', 'qrImageUrl', 'brebKey',
          'accountHolder', 'bankName', 'paymentInstructions', 'deliveryInstructions',
          'ownerUid', 'updatedAt'
        ]) &&
        data.id == workspaceId &&
        isSafeTextBounded(data.businessName, 1, 120) &&
        data.enabled is bool &&
        isSafeUrlBounded(data.qrImageUrl, 0, 250000) &&
        isSafeTextBounded(data.brebKey, 0, 100) &&
        isSafeTextBounded(data.accountHolder, 0, 120) &&
        isSafeTextBounded(data.bankName, 0, 120) &&
        isSafeTextBounded(data.paymentInstructions, 0, 400) &&
        isSafeTextBounded(data.deliveryInstructions, 0, 400) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        data.updatedAt is timestamp;
    }

    function isValidPublicProduct(data, productId) {
      return data.keys().hasAll([
          'id', 'name', 'category', 'basePrice', 'imageUrl', 'baseRecipe',
          'removableOptions', 'addonOptions', 'allowSauces', 'minSauces',
          'maxSauces', 'active', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'category', 'basePrice', 'imageUrl', 'baseRecipe',
          'removableOptions', 'addonOptions', 'allowSauces', 'minSauces',
          'maxSauces', 'active', 'updatedAt'
        ]) &&
        data.id == productId &&
        isSafeTextBounded(data.name, 1, 100) &&
        isSafeTextBounded(data.category, 1, 60) &&
        data.basePrice is number && data.basePrice >= 0 && data.basePrice <= 100000000 &&
        isSafeUrlBounded(data.imageUrl, 0, 250000) &&
        isStringListBounded(data.baseRecipe, 30) &&
        isStringListBounded(data.removableOptions, 30) &&
        data.addonOptions is list && data.addonOptions.size() <= 30 &&
        (data.addonOptions.size() == 0 || (data.addonOptions[0] is map && data.addonOptions[0].keys().hasAll(['id', 'name', 'price']))) &&
        data.allowSauces is bool &&
        data.minSauces is number && data.minSauces >= 0 && data.minSauces <= 4 &&
        data.maxSauces is number && data.maxSauces >= 0 && data.maxSauces <= 4 &&
        data.active is bool &&
        data.updatedAt is timestamp;
    }

    function isValidPublicSauce(data, sauceId) {
      return data.keys().hasAll(['id', 'name', 'active', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'active', 'updatedAt']) &&
        data.id == sauceId &&
        isSafeTextBounded(data.name, 1, 60) &&
        data.active is bool &&
        data.updatedAt is timestamp;
    }

    function isValidQueueTicket(data, ticketId) {
      return data.keys().hasAll(['id', 'orderNumber', 'status', 'deliveryType', 'createdAtMs', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'orderNumber', 'status', 'deliveryType', 'createdAtMs', 'createdAt', 'updatedAt']) &&
        data.id == ticketId &&
        data.orderNumber is number && data.orderNumber >= 1 && data.orderNumber <= 10000000 &&
        data.status in ['pendiente_validacion', 'tomado', 'preparacion', 'listo', 'entregado', 'cancelado'] &&
        data.deliveryType in ['local', 'domicilio'] &&
        data.createdAtMs is number && data.createdAtMs > 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSelfOrder(data, orderId) {
      return data.keys().hasAll([
          'id', 'orderNumber', 'reference', 'source', 'deliveryType',
          'deliveryAddress', 'deliveryNeighborhood', 'deliveryPhone', 'deliveryNotes',
          'customerName', 'status', 'paymentStatus', 'paymentMethod',
          'items', 'subtotal', 'total', 'notes', 'receiptCount',
          'latestReceiptUrl', 'receiptStoragePath',
          'ownerUid', 'createdByUid', 'createdAtMs', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'orderNumber', 'reference', 'source', 'deliveryType',
          'deliveryAddress', 'deliveryNeighborhood', 'deliveryPhone', 'deliveryNotes',
          'customerName', 'status', 'paymentStatus', 'paymentMethod',
          'items', 'subtotal', 'total', 'notes', 'receiptCount',
          'latestReceiptUrl', 'receiptStoragePath',
          'voidReason', 'voidedByName', 'voidedAtMs', 'refundMethod', 'refundAmount',
          'ownerUid', 'createdByUid', 'createdAtMs', 'createdAt', 'updatedAt'
        ]) &&
        data.id == orderId &&
        data.orderNumber is number && data.orderNumber >= 1 && data.orderNumber <= 10000000 &&
        isSafeTextBounded(data.reference, 1, 100) &&
        data.source == 'autoservicio' &&
        data.deliveryType in ['local', 'domicilio'] &&
        isSafeTextBounded(data.deliveryAddress, 0, 220) &&
        isSafeTextBounded(data.deliveryNeighborhood, 0, 100) &&
        isSafeTextBounded(data.deliveryPhone, 0, 40) &&
        isSafeTextBounded(data.deliveryNotes, 0, 240) &&
        isSafeTextBounded(data.customerName, 2, 120) &&
        (
          data.deliveryType == 'local' ||
          (
            isSafeTextBounded(data.deliveryAddress, 5, 220) &&
            isSafeTextBounded(data.deliveryNeighborhood, 2, 100) &&
            isSafeTextBounded(data.deliveryPhone, 7, 40)
          )
        ) &&
        data.status in ['pendiente_validacion', 'tomado', 'preparacion', 'listo', 'entregado', 'cancelado'] &&
        data.paymentStatus in ['pendiente', 'pagado'] &&
        data.paymentMethod == 'transferencia' &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 50 &&
        data.items[0] is map &&
        data.items[0].keys().hasAll(['lineId', 'productId', 'productName', 'quantity', 'unitPrice', 'lineTotal']) &&
        isSafeTextBounded(data.items[0].productName, 1, 100) &&
        data.subtotal is number && data.subtotal > 0 && data.subtotal <= 100000000 &&
        data.total is number && data.total > 0 && data.total <= 100000000 &&
        isSafeTextBounded(data.notes, 0, 400) &&
        data.receiptCount is number && data.receiptCount >= 0 && data.receiptCount <= 10 &&
        isSafeUrlBounded(data.latestReceiptUrl, 0, 250000) &&
        isSafeTextBounded(data.receiptStoragePath, 0, 500) &&
        (!('voidReason' in data) || isSafeTextBounded(data.voidReason, 0, 240)) &&
        (!('voidedByName' in data) || isSafeTextBounded(data.voidedByName, 0, 80)) &&
        (!('voidedAtMs' in data) || data.voidedAtMs is number) &&
        (!('refundMethod' in data) || data.refundMethod in ['', 'efectivo', 'transferencia', 'tarjeta', 'otro']) &&
        (!('refundAmount' in data) || (data.refundAmount is number && data.refundAmount >= 0 && data.refundAmount <= 100000000)) &&
        isStringBounded(data.ownerUid, 1, 128) &&
        isStringBounded(data.createdByUid, 1, 128) &&
        data.createdAtMs is number && data.createdAtMs > 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Workspaces & Admin Role Control vs Waiter/Cashier/Kitchen Operations
    match /workspaceDirectory/{workspaceId} {
      allow get: if isAuthenticatedEmailUser() && isValidId(workspaceId);
      allow list: if false;
      allow create: if isAuthenticatedEmailUser() && isValidId(workspaceId) &&
        isPrimaryAdmin(workspaceId) &&
        isValidWorkspaceDirectory(incoming(), workspaceId) &&
        incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
        incoming().updatedAt == request.time;
      allow update: if isAuthenticatedEmailUser() && isValidId(workspaceId) &&
        isWorkspaceAdmin(workspaceId) &&
        isValidWorkspaceDirectory(incoming(), workspaceId) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'allowSelfRegistration', 'updatedAt']);
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow get: if isAuthenticatedEmailUser() && isValidId(workspaceId) && (
        isBootstrappedAdmin() ||
        isActiveWorkspaceMember(workspaceId) ||
        (resource != null && (
          existing().ownerUid == request.auth.uid ||
          request.auth.token.email in existing().authorizedEmails
        ))
      );
      allow list: if isAuthenticatedEmailUser() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        request.auth.token.email in resource.data.authorizedEmails
      );
      allow create: if isAuthenticatedEmailUser() && isValidId(workspaceId) &&
        (workspaceId != 'ws_onde_luigi' || isBootstrappedAdmin()) &&
        isValidWorkspace(incoming(), workspaceId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isWorkspaceAdmin(workspaceId) && isValidId(workspaceId) &&
        isValidWorkspace(incoming(), workspaceId) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        existing().ownerEmail in incoming().authorizedEmails &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'authorizedEmails', 'billingConfig', 'selfServiceConfig', 'updatedAt']);
      allow delete: if false;

      // ADMINS CAN MANAGE NON-OWNER MEMBERS; NO DIRECT SELF-CREATION (MUST PASS WAITING SCREEN)
      match /members/{uid} {
        allow get: if isAuthenticatedEmailUser() && isValidId(uid) && (
          uid == request.auth.uid || isWorkspaceAdmin(workspaceId)
        );
        allow list: if isAuthenticatedEmailUser() && (
          isBootstrappedAdmin() ||
          isWorkspaceAdmin(workspaceId) ||
          resource.data.ownerUid == request.auth.uid ||
          resource.data.uid == request.auth.uid
        );
        allow create: if isAuthenticatedEmailUser() && isValidId(uid) &&
          isWorkspaceAdmin(workspaceId) &&
          isValidWorkspaceMember(incoming(), uid) &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time;
        allow update: if isWorkspaceAdmin(workspaceId) && isValidId(uid) &&
          isValidWorkspaceMember(incoming(), uid) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          (uid != existing().ownerUid || (isPrimaryAdmin(workspaceId) && incoming().role == 'admin' && incoming().active == true)) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'active']);
        allow delete: if isWorkspaceAdmin(workspaceId) && isValidId(uid) && uid != existing().ownerUid;
      }

      // ADMIN-CONTROLLED STAFF ROSTER & ROLE ASSIGNMENT (NO SELF-PROMOTION OR DIRECT ENTRY)
      match /staff/{staffId} {
        allow get: if isValidId(staffId) && isAuthorizedWorkspaceUser(workspaceId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(staffId) &&
          isWorkspaceAdmin(workspaceId) &&
          isValidStaffMember(incoming(), staffId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(staffId) &&
          isValidStaffMember(incoming(), staffId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (existing().linkedUid != existing().ownerUid || incoming().active == true) &&
          (
            (
              isPrimaryAdmin(workspaceId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'active', 'linkedUid', 'linkedEmail', 'allowedEmails', 'updatedAt'])
            ) ||
            (
              isWorkspaceAdmin(workspaceId) &&
              existing().linkedUid != existing().ownerUid &&
              existing().linkedEmail != 'perrodog1515@gmail.com' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'active', 'linkedUid', 'linkedEmail', 'allowedEmails', 'updatedAt'])
            ) ||
            (
              isWorkspaceAdmin(workspaceId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['allowedEmails', 'updatedAt'])
            )
          );
        allow delete: if isValidId(staffId) &&
          isWorkspaceAdmin(workspaceId) &&
          existing().linkedUid != existing().ownerUid &&
          existing().linkedEmail != 'perrodog1515@gmail.com';
      }

      // ADMIN-ONLY WRITE (Primary + Promoted Admins): Sauces Catalog
      match /sauces/{sauceId} {
        allow get: if isValidId(sauceId) && isAuthorizedWorkspaceUser(workspaceId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(sauceId) && isWorkspaceAdmin(workspaceId) &&
          isValidSauce(incoming(), sauceId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(sauceId) && isWorkspaceAdmin(workspaceId) &&
          isValidSauce(incoming(), sauceId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'active', 'allowedEmails', 'updatedAt']);
        allow delete: if isValidId(sauceId) && isWorkspaceAdmin(workspaceId);
      }

      // ADMIN-ONLY WRITE (Primary + Promoted Admins): Menu Products, Recipes & Drinks
      match /products/{productId} {
        allow get: if isValidId(productId) && isAuthorizedWorkspaceUser(workspaceId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(productId) && isWorkspaceAdmin(workspaceId) &&
          isValidProduct(incoming(), productId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(productId) && isWorkspaceAdmin(workspaceId) &&
          isValidProduct(incoming(), productId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'basePrice', 'imageUrl', 'baseRecipe', 'removableOptions', 'recipeIngredients', 'addonOptions', 'allowSauces', 'minSauces', 'maxSauces', 'active', 'allowedEmails', 'updatedAt']);
        allow delete: if isValidId(productId) && isWorkspaceAdmin(workspaceId);
      }

      // ADMIN + AUTHORIZED WAITERS: Orders (Admins can permanently purge annulled orders)
      match /orders/{orderId} {
        allow get: if isValidId(orderId) && isAuthorizedWorkspaceUser(workspaceId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(orderId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidOrder(incoming(), orderId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(orderId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidOrder(incoming(), orderId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isWorkspaceAdmin(workspaceId) ||
            (
              existing().status != 'cancelado' &&
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['items', 'subtotal', 'total', 'notes', 'reference', 'inventoryDeducted', 'customerId', 'customerDocument', 'customerName', 'customerPhone', 'customerEmail', 'waiterId', 'waiterName', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'inventoryDeducted', 'waiterId', 'waiterName', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'inventoryDeducted', 'voidReason', 'voidedByName', 'voidedAtMs', 'refundMethod', 'refundAmount', 'waiterId', 'waiterName', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'paymentMethod', 'receiptCount', 'latestReceiptUrl', 'customerId', 'customerDocument', 'customerName', 'customerPhone', 'customerEmail', 'inventoryDeducted', 'waiterId', 'waiterName', 'updatedAt'])
              )
            )
          );
        allow delete: if isValidId(orderId) && isWorkspaceAdmin(workspaceId);
      }

      // IMMUTABLE AUDIT LOG: Movements (Admin can permanently purge trace)
      match /movements/{movementId} {
        allow get: if isValidId(movementId) && isAuthorizedWorkspaceUser(workspaceId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(movementId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidMovement(incoming(), movementId) &&
          incoming().actorUid == request.auth.uid &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/orders/$(incoming().orderId));
        allow update: if false;
        allow delete: if isValidId(movementId) && isWorkspaceAdmin(workspaceId);
      }

      // TRANSFER RECEIPTS
      match /transfers/{transferId} {
        allow get: if isValidId(transferId) && isAuthorizedWorkspaceUser(workspaceId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(transferId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidTransfer(incoming(), transferId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/orders/$(incoming().orderId));
        allow update: if isValidId(transferId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidTransfer(incoming(), transferId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'notes', 'annulled', 'annulledByName', 'annulledReason', 'annulledAtMs']);
        allow delete: if isValidId(transferId) && isWorkspaceAdmin(workspaceId);
      }

      // CASH SHIFTS (Open/Close by authorized staff; Admin can delete closed records)
      match /shifts/{shiftId} {
        allow get: if isValidId(shiftId) && isAuthorizedWorkspaceUser(workspaceId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(shiftId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidShift(incoming(), shiftId) &&
          incoming().status == 'abierto' &&
          incoming().openedByUid == request.auth.uid &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(shiftId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidShift(incoming(), shiftId) &&
          (existing().status == 'abierto' || isWorkspaceAdmin(workspaceId)) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (
              existing().status == 'abierto' &&
              incoming().status == 'cerrado' &&
              incoming().closedByUid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'closedByStaffId', 'closedByName', 'closedByUid',
                'closingNote', 'usedPaymentMethods', 'declaredClosingBase', 'declaredByMethod',
                'expectedBaseAmount', 'expectedByMethod', 'expectedTotal',
                'declaredTotal', 'differenceTotal', 'paidOrdersCount', 'pendingOrdersCount',
                'updatedAt'
              ])
            ) ||
            (
              isWorkspaceAdmin(workspaceId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['allowedEmails', 'updatedAt'])
            )
          );
        allow delete: if isValidId(shiftId) && isWorkspaceAdmin(workspaceId);
      }

      // SAVED CUSTOMERS (NIT/Cédula directory for optional receipt generation)
      match /customers/{customerId} {
        allow get: if isValidId(customerId) && isAuthorizedWorkspaceUser(workspaceId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(customerId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidCustomer(incoming(), customerId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(customerId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidCustomer(incoming(), customerId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['documentNumber', 'name', 'phone', 'email', 'notes', 'allowedEmails', 'updatedAt']);
        allow delete: if isValidId(customerId) && isWorkspaceAdmin(workspaceId);
      }

      // TRACKABLE INVENTORY INGREDIENTS (Admin full write; Authorized staff atomic stock deduction during orders)
      match /inventory/{itemId} {
        allow get: if isValidId(itemId) && isAuthorizedWorkspaceUser(workspaceId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(itemId) && isWorkspaceAdmin(workspaceId) &&
          isValidInventoryItem(incoming(), itemId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(itemId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidInventoryItem(incoming(), itemId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (
              isWorkspaceAdmin(workspaceId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'nameKey', 'unit', 'currentStock', 'minStock',
                'unitCost', 'lastPurchaseQuantity', 'lastPurchaseTotalCost',
                'active', 'allowedEmails', 'updatedAt'
              ])
            ) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['currentStock', 'updatedAt'])
          );
        allow delete: if isValidId(itemId) && isWorkspaceAdmin(workspaceId);
      }

      // IMMUTABLE INVENTORY LEDGER (Purchases, recipe consumption, edits, voids, adjustments)
      match /inventoryMovements/{movId} {
        allow get: if isValidId(movId) && isAuthorizedWorkspaceUser(workspaceId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(movId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidInventoryMovement(incoming(), movId) &&
          incoming().actorUid == request.auth.uid &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          (
            isWorkspaceAdmin(workspaceId) ||
            (
              incoming().type in ['consumo_pedido', 'edicion_pedido', 'anulacion_pedido'] &&
              incoming().orderId.size() > 0 &&
              existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/orders/$(incoming().orderId))
            )
          );
        allow update: if false;
        allow delete: if isValidId(movId) && isWorkspaceAdmin(workspaceId);
      }

      // REAL-TIME WORKSPACE NOTIFICATIONS (Orders, Shift Open/Close, Voided Orders/Sales)
      match /notifications/{notifId} {
        allow get: if isValidId(notifId) && isAuthorizedWorkspaceUser(workspaceId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(notifId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidNotification(incoming(), notifId) &&
          incoming().actorUid == request.auth.uid &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(notifId) && isWorkspaceAdmin(workspaceId);
      }

      // ADMIN-ONLY BULK PURCHASE INVOICES & BUSINESS EXPENSES
      match /purchaseInvoices/{invoiceId} {
        allow get: if isValidId(invoiceId) && isWorkspaceAdmin(workspaceId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(invoiceId) && isWorkspaceAdmin(workspaceId) &&
          isValidPurchaseInvoice(incoming(), invoiceId) &&
          incoming().actorUid == request.auth.uid &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(invoiceId) && isWorkspaceAdmin(workspaceId) &&
          isValidPurchaseInvoice(incoming(), invoiceId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['allowedEmails', 'updatedAt']);
        allow delete: if isValidId(invoiceId) && isWorkspaceAdmin(workspaceId);
      }

      // WAITING-SCREEN ACCESS REQUESTS (Pending users submit/view own request; Admins review & assign role)
      match /accessRequests/{reqId} {
        allow get: if isAuthenticatedEmailUser() && isValidId(reqId) && (
          reqId == request.auth.uid || isWorkspaceAdmin(workspaceId)
        );
        allow list: if isWorkspaceAdmin(workspaceId);
        allow create: if isAuthenticatedEmailUser() && isValidId(reqId) &&
          reqId == request.auth.uid &&
          isValidAccessRequest(incoming(), reqId) &&
          incoming().status == 'pending' &&
          incoming().email.lower() == request.auth.token.email.lower() &&
          !('assignedRole' in incoming()) &&
          !('reviewedByUid' in incoming()) &&
          !('reviewedByName' in incoming()) &&
          !('rejectionReason' in incoming()) &&
          workspaceExists(workspaceId) &&
          incoming().ownerUid == get(workspacePath(workspaceId)).data.ownerUid &&
          (
            (exists(directoryPath(workspaceId)) && get(directoryPath(workspaceId)).data.allowSelfRegistration == true) ||
            (request.auth.token.email in get(workspacePath(workspaceId)).data.authorizedEmails)
          ) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isAuthenticatedEmailUser() && isValidId(reqId) &&
          isValidAccessRequest(incoming(), reqId) &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().updatedAt == request.time &&
          (
            (
              isWorkspaceAdmin(workspaceId) &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'requestedName', 'assignedRole',
                'rejectionReason', 'reviewedByUid', 'reviewedByName', 'updatedAt'
              ])
            ) ||
            (
              reqId == request.auth.uid &&
              existing().status == 'pending' &&
              incoming().status == 'pending' &&
              incoming().createdAt == existing().createdAt &&
              incoming().diff(existing()).affectedKeys().hasOnly(['requestedName', 'updatedAt'])
            ) ||
            (
              reqId == request.auth.uid &&
              existing().status == 'approved' &&
              !exists(memberPath(workspaceId, request.auth.uid)) &&
              incoming().status == 'pending' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'requestedName', 'status', 'createdAt', 'updatedAt'])
            )
          );
        allow delete: if isValidId(reqId) && isWorkspaceAdmin(workspaceId);
      }

      // BACKGROUND WEB PUSH SUBSCRIPTIONS (Strictly Active Approved Staff Accounts Only)
      match /pushSubscriptions/{subId} {
        allow get: if isAuthenticatedEmailUser() && isValidId(subId) && (
          subId == 'sub_' + request.auth.uid || isWorkspaceAdmin(workspaceId)
        );
        allow list: if isWorkspaceAdmin(workspaceId) || (
          isActiveWorkspaceMember(workspaceId) &&
          resource.data.uid == request.auth.uid
        );
        allow create: if isAuthenticatedEmailUser() && isValidId(subId) &&
          subId == 'sub_' + request.auth.uid &&
          (isPrimaryAdmin(workspaceId) || isActiveWorkspaceMember(workspaceId)) &&
          isValidPushSubscription(incoming(), subId) &&
          incoming().uid == request.auth.uid &&
          incoming().createdByUid == request.auth.uid &&
          incoming().active == true &&
          (
            isPrimaryAdmin(workspaceId) ||
            (
              exists(staffPath(workspaceId, incoming().staffId)) &&
              get(staffPath(workspaceId, incoming().staffId)).data.active == true
            )
          ) &&
          workspaceExists(workspaceId) &&
          incoming().ownerUid == get(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isAuthenticatedEmailUser() && isValidId(subId) &&
          subId == 'sub_' + request.auth.uid &&
          (isPrimaryAdmin(workspaceId) || isActiveWorkspaceMember(workspaceId)) &&
          isValidPushSubscription(incoming(), subId) &&
          incoming().uid == existing().uid &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time;
        allow delete: if isAuthenticatedEmailUser() && isValidId(subId) && (
          isWorkspaceAdmin(workspaceId) || subId == 'sub_' + request.auth.uid
        );
      }

      // ADMIN-ONLY PAYROLL MODULE (Companies, Employees, Hours, Deductions, Stubs)
      match /payrollCompanies/{companyId} {
        allow get: if isValidId(companyId) && isWorkspaceAdmin(workspaceId);
        allow list: if isWorkspaceAdmin(workspaceId);
        allow create: if isValidId(companyId) && isWorkspaceAdmin(workspaceId) &&
          isValidPayrollCompany(incoming(), companyId) &&
          incoming().createdByUid == request.auth.uid &&
          incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(companyId) && isWorkspaceAdmin(workspaceId) &&
          isValidPayrollCompany(incoming(), companyId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'nit', 'address', 'phone', 'email', 'rep', 'legal',
            'logo', 'employees', 'stubs', 'allowedEmails', 'updatedAt'
          ]);
        allow delete: if isValidId(companyId) && isWorkspaceAdmin(workspaceId);
      }
    }

    // 5. Public Customer Self-Service Storefront (Strictly Isolated from Admin/POS & Staff PII)
    match /publicStorefronts/{workspaceId} {
      allow get: if isValidId(workspaceId);
      allow list: if false;
      allow create: if isValidId(workspaceId) && isWorkspaceAdmin(workspaceId) &&
        isValidPublicStorefront(incoming(), workspaceId) &&
        incoming().ownerUid == getAfter(workspacePath(workspaceId)).data.ownerUid &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(workspaceId) && isWorkspaceAdmin(workspaceId) &&
        isValidPublicStorefront(incoming(), workspaceId) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().updatedAt == request.time;
      allow delete: if false;

      match /products/{productId} {
        allow get: if isValidId(productId);
        allow list: if resource.data.active in [true, false];
        allow create, update: if isValidId(productId) && isWorkspaceAdmin(workspaceId) &&
          isValidPublicProduct(incoming(), productId) &&
          incoming().updatedAt == request.time;
        allow delete: if isValidId(productId) && isWorkspaceAdmin(workspaceId);
      }

      match /sauces/{sauceId} {
        allow get: if isValidId(sauceId);
        allow list: if resource.data.active in [true, false];
        allow create, update: if isValidId(sauceId) && isWorkspaceAdmin(workspaceId) &&
          isValidPublicSauce(incoming(), sauceId) &&
          incoming().updatedAt == request.time;
        allow delete: if isValidId(sauceId) && isWorkspaceAdmin(workspaceId);
      }

      match /queueTickets/{ticketId} {
        allow get: if isValidId(ticketId);
        allow list: if resource.data.status in ['pendiente_validacion', 'tomado', 'preparacion', 'listo', 'entregado', 'cancelado'];
        allow create: if isValidId(ticketId) &&
          isValidQueueTicket(incoming(), ticketId) &&
          incoming().status == 'pendiente_validacion' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (
            isAuthorizedWorkspaceUser(workspaceId) ||
            existsAfter(/databases/$(database)/documents/publicStorefronts/$(workspaceId)/selfOrders/$(ticketId))
          );
        allow update: if isValidId(ticketId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidQueueTicket(incoming(), ticketId) &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time;
        allow delete: if isValidId(ticketId) && isWorkspaceAdmin(workspaceId);
      }

      match /selfOrders/{orderId} {
        allow get: if isValidId(orderId);
        allow list: if canListWorkspaceSubcollection(workspaceId);
        allow create: if isValidId(orderId) &&
          isValidSelfOrder(incoming(), orderId) &&
          incoming().status == 'pendiente_validacion' &&
          incoming().paymentStatus == 'pendiente' &&
          incoming().paymentMethod == 'transferencia' &&
          incoming().receiptCount == 1 &&
          incoming().latestReceiptUrl.size() > 0 &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/publicStorefronts/$(workspaceId)) &&
          get(/databases/$(database)/documents/publicStorefronts/$(workspaceId)).data.enabled == true &&
          incoming().ownerUid == get(/databases/$(database)/documents/publicStorefronts/$(workspaceId)).data.ownerUid &&
          existsAfter(/databases/$(database)/documents/publicStorefronts/$(workspaceId)/queueTickets/$(orderId));
        allow update: if isValidId(orderId) && isAuthorizedWorkspaceUser(workspaceId) &&
          isValidSelfOrder(incoming(), orderId) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time;
        allow delete: if isValidId(orderId) && isWorkspaceAdmin(workspaceId);
      }
    }
  }
}
